MONETIZATION_ENDPOINT=https://us-west-2.alpha.monetization.aws.dev
MONETIZATION_REGION=us-west-2
# Sandbox: test the full experience, including checkout, with no real charges.
# Live: real customers, real charges. To switch, swap which line is commented and restart.
MONETIZATION_APP_ID=arn:aws:appmonetization:us-west-2:908494156008:apps/01a12d3d59267206ba3310b8418c4a21/sandbox
# MONETIZATION_APP_ID=arn:aws:appmonetization:us-west-2:908494156008:apps/01a12d3d59267206ba3310b8418c4a21
# Entitlement gate. A new user starts on the Free plan (verified in the sandbox), so enforcement is safe to leave on.
MONETIZATION_ENFORCE=true
