{
  "name": "workspacezero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:db": "node --conditions=react-server --import tsx scripts/verify-db.ts",
    "verify:luminal-contract": "node --conditions=react-server --import tsx scripts/verify-luminal-contract.ts",
    "verify:luminal-live": "node --conditions=react-server --import tsx scripts/verify-luminal-live.ts",
    "verify:api": "node --conditions=react-server --import tsx scripts/verify-api.ts",
    "db:reset": "node --conditions=react-server --import tsx scripts/reset-db.ts",
    "verify:accounts": "node --import tsx scripts/verify-accounts.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@aws-app-monetization/monetize-skill": "^0.1.1791678431",
    "@aws-app-monetization/sdk": "^0.1.1791657605",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "jose": "^6.2.12",
    "mongodb": "^7.7.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
