# Server-only. Copy to .env.local and fill values locally; never commit secrets.
MONGODB_URI=
MONGODB_DB=
LUMINAL_API_KEY=
# Verified OpenAI-compatible base URL, not a guessed endpoint.
LUMINAL_BASE_URL=
# Exact identifier from Luminal's dashboard/documentation.
LUMINAL_MODEL=
# Generate a strong random secret when authentication is implemented.
SESSION_SECRET=
# Billing. Leave BILLING_PROVIDER unset (placeholder) until the AWS monetization service is connected.
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
